#!/bin/sh
echo ""
echo "🛡️  GitGuard is checking your push..."
echo ""
cat - | node scripts/gitguard.js pre-push
EXIT_CODE=$?
if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "🚫 GitGuard blocked this push. Fix the issues above first!"
  echo ""
  exit 1
fi
echo ""
echo "✅ GitGuard approved your push!"
echo ""